; Forbidden states for the libcpg / Datalog / Replete responsibility boundary.
(set-logic QF_LIA)

(declare-const replayed_proof Bool)
(declare-const equality_complete Bool)
(declare-const datalog_complete Bool)
(declare-const stable_source_identity Bool)
(declare-const canonical_input Bool)
(declare-const shared_mutable_state Bool)
(declare-const reverse_dependency Bool)
(declare-const embedded_runtime Bool)
(declare-const tuple_promoted_to_proof Bool)
(declare-const internal_class_id_requested Bool)
(declare-const cpg_unchanged Bool)
(declare-const report_unchanged Bool)
(declare-const internal_class_id_escaped Bool)

(define-fun architecture_safe () Bool
  (and (not shared_mutable_state) (not reverse_dependency)
       (not embedded_runtime) (not tuple_promoted_to_proof)
       (not internal_class_id_requested)))
(define-fun publish_fact () Bool
  (and architecture_safe replayed_proof stable_source_identity canonical_input))
(define-fun allow_absence () Bool
  (and architecture_safe equality_complete datalog_complete))
(define-fun completion_is_complete () Bool
  (and equality_complete datalog_complete))

(assert cpg_unchanged)
(assert report_unchanged)
(assert (not internal_class_id_escaped))

(echo "published semantic fact requires replayed proof")
(push)
(assert publish_fact)
(assert (not replayed_proof))
(check-sat)
(pop)

(echo "published semantic fact requires stable source identity")
(push)
(assert publish_fact)
(assert (not stable_source_identity))
(check-sat)
(pop)

(echo "published semantic fact requires canonical input")
(push)
(assert publish_fact)
(assert (not canonical_input))
(check-sat)
(pop)

(echo "a valid positive survives incomplete equality search")
(push)
(assert architecture_safe)
(assert replayed_proof)
(assert stable_source_identity)
(assert canonical_input)
(assert (not equality_complete))
(assert (not publish_fact))
(check-sat)
(pop)

(echo "a valid positive survives incomplete Datalog evaluation")
(push)
(assert architecture_safe)
(assert replayed_proof)
(assert stable_source_identity)
(assert canonical_input)
(assert (not datalog_complete))
(assert (not publish_fact))
(check-sat)
(pop)

(echo "absence requires equality completion")
(push)
(assert allow_absence)
(assert (not equality_complete))
(check-sat)
(pop)

(echo "absence requires Datalog completion")
(push)
(assert allow_absence)
(assert (not datalog_complete))
(check-sat)
(pop)

(echo "complete status requires equality completion")
(push)
(assert completion_is_complete)
(assert (not equality_complete))
(check-sat)
(pop)

(echo "complete status requires Datalog completion")
(push)
(assert completion_is_complete)
(assert (not datalog_complete))
(check-sat)
(pop)

(echo "shared mutable state is outside the architecture")
(push)
(assert architecture_safe)
(assert shared_mutable_state)
(check-sat)
(pop)

(echo "reverse dependency is outside the architecture")
(push)
(assert architecture_safe)
(assert reverse_dependency)
(check-sat)
(pop)

(echo "embedded Datalog runtime is outside the architecture")
(push)
(assert architecture_safe)
(assert embedded_runtime)
(check-sat)
(pop)

(echo "Datalog tuple cannot be promoted to equality proof")
(push)
(assert architecture_safe)
(assert tuple_promoted_to_proof)
(check-sat)
(pop)

(echo "engine-local e-class identity cannot enter public facts")
(push)
(assert architecture_safe)
(assert internal_class_id_requested)
(check-sat)
(pop)

(echo "public facts cannot leak an internal e-class id")
(push)
(assert internal_class_id_escaped)
(check-sat)
(pop)

(echo "semantic export cannot mutate the CPG")
(push)
(assert (not cpg_unchanged))
(check-sat)
(pop)

(echo "semantic export cannot mutate its input report")
(push)
(assert (not report_unchanged))
(check-sat)
(pop)

(echo "limited equality cannot authorize absence")
(push)
(assert (not equality_complete))
(assert allow_absence)
(check-sat)
(pop)

(echo "limited Datalog cannot authorize absence")
(push)
(assert (not datalog_complete))
(assert allow_absence)
(check-sat)
(pop)

(echo "safe architecture publishes every proof-backed canonical stable fact")
(push)
(assert architecture_safe)
(assert replayed_proof)
(assert stable_source_identity)
(assert canonical_input)
(assert (not publish_fact))
(check-sat)
(pop)
