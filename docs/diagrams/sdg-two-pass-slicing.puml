@startuml
!include _libcpg-theme.iuml
title Context-sensitive two-pass SDG slicing

skinparam backgroundColor #FCFCFC
skinparam rectangle {
  BorderColor #343A40
  FontColor #212529
  RoundCorner 12
}
skinparam note {
  BackgroundColor #F8F9FA
  BorderColor #495057
}

rectangle "Criterion\n<latex>s \in V</latex>" as START #DBE4FF

package "Backward slice · incoming edges" #E7F5FF {
  rectangle "Phase B1 · ascend\nallow PDG + summary + Parameter\nexclude ReturnValue" as B1 #D3F9D8
  rectangle "Phase B1 nodes\nwith minimum call depth" as BS #FFF3BF
  rectangle "Phase B2 · descend\nallow PDG + summary + ReturnValue\nexclude Parameter" as B2 #E5DBFF
  rectangle "Backward BTreeSet\nno sibling-call return" as BO #FCC2D7
  B1 --> BS : stable BFS
  BS --> B2 : seed every reached node
  B2 --> BO : union under max_nodes
}

package "Forward slice · outgoing edges" #FFF4E6 {
  rectangle "Phase F1 · ascend\nallow PDG + summary + ReturnValue\nexclude Parameter" as F1 #C3FAE8
  rectangle "Phase F1 nodes\nwith minimum call depth" as FS #FFE8CC
  rectangle "Phase F2 · descend\nallow PDG + summary + Parameter\nexclude ReturnValue" as F2 #FFD8A8
  rectangle "Forward BTreeSet\nno sibling-call return" as FO #FFE3E3
  F1 --> FS : stable BFS
  FS --> F2 : seed every reached node
  F2 --> FO : union under max_nodes
}

START --> B1 : backward API
START --> F1 : forward API

note bottom of BS
  Parameter and ReturnValue cost one call boundary.
  PDG and summary edges cost zero.
  A shallower rediscovery is expanded again.
end note

note bottom of FO
  Sorting neighbors by NodeId and edge cost makes
  capped prefixes independent of edge insertion order.
end note

legend bottom
|= Colour |= Meaning |
|<#DBE4FF>| slicing criterion |
|<#D3F9D8>| backward ascent |
|<#FFF3BF>| backward phase boundary |
|<#E5DBFF>| backward descent |
|<#FCC2D7>| backward result |
|<#C3FAE8>| forward ascent |
|<#FFE8CC>| forward phase boundary |
|<#FFD8A8>| forward descent |
|<#FFE3E3>| forward result |
endlegend
@enduml
