// complexity-ladder.dot — ComplexityClass growth rates, fastest (top) -> slowest (bottom).
// Vertical order encodes the private growth-faithful rank behind
// ComplexityClass::is_better_than().  Graphviz cannot typeset
// LaTeX, so Big-O is written in plain text (O(n^2), O(2^n), ...).
digraph complexity_ladder {
  bgcolor="white";
  rankdir=TB;
  nodesep=0.35;
  ranksep=0.30;
  node [fontname="DejaVu Sans", shape=box, style="filled,rounded", fontsize=12, width=2.6, height=0.62];
  edge [color="#495057", arrowsize=0.8];

  Constant     [label="Constant = Polynomial(0)\nO(1)  —  rank 0", fillcolor="#F1F3F5", color="#495057"];
  Logarithmic  [label="Logarithmic  —  O(log n)\nrank 1", fillcolor="#F3F1F3", color="#5C4C52"];
  Linear       [label="Linear = Polynomial(1)\nO(n)  —  rank 2", fillcolor="#F4EFF0", color="#6F484E"];
  Linearithmic [label="Linearithmic  —  O(n log n)\nrank 3", fillcolor="#F6EDEE", color="#824449"];
  Quadratic    [label="Quadratic = Polynomial(2)\nO(n^2)  —  rank 4", fillcolor="#F8EBEC", color="#944044"];
  Cubic        [label="Cubic = Polynomial(3)\nO(n^3)  —  rank 5", fillcolor="#FAE9EA", color="#A73D3F"];
  Polynomial   [label="Polynomial(k), k >= 4  —  O(n^k)\nrank 6 - 1/k", fillcolor="#FCE7E8", color="#BA393A"];
  Exponential  [label="Exponential  —  O(2^n)\nrank 10", fillcolor="#FDE5E5", color="#CD3536"];
  Factorial    [label="Factorial  —  O(n!)\nrank 20", fillcolor="#FFE3E3", color="#E03131"];

  Constant -> Logarithmic -> Linear -> Linearithmic -> Quadratic
            -> Cubic -> Polynomial -> Exponential -> Factorial;

  // Severity axis + legend, pinned beside the top of the ladder.
  legend [shape=plaintext, fillcolor="white", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#F1F3F5"><b>fastest</b> — neutral (rank 0)</td></tr>
      <tr><td bgcolor="#F6EDEE">warming — growth accelerates</td></tr>
      <tr><td bgcolor="#FFE3E3"><b>slowest represented growth</b> — crimson (rank 20)</td></tr>
      <tr><td>fill = severity&#183; top-to-bottom = asymptotic growth&#183; equivalent polynomial forms share a rank</td></tr>
    </table>
  >];
  { rank=same; Constant; legend; }
  Constant -> legend [style=invis];
}
