@startuml
!include _libcpg-theme.iuml
title CPG analysis pipeline — analysis families fan out over one CodePropertyGraph
start
:CodePropertyGraph
(AST + CFG + DFG over one shared node set);
fork
  :block_cfg → solve(DataflowAnalysis)
  + liveness / dead_stores
  + available / very-busy expressions
  + SCCP constants / executable edges
  + interval value ranges / widening
  + dominator_tree / post_dominator_tree
  + loop_forest
  + loop_induction / invariants / IVs
  + unreachable_code
  + control_flow_sccs / call_graph_sccs
  + condensation_metrics / Coffman-Graham layering
  + infer_layering / cycle-skip-upward witnesses
  + analyze_dsm / core-periphery / cyclic core
  + Martin Ca / Ce / I / A / D / SDP witnesses
  + architecture_smells / cycle-hub-instability-size evidence
  + wl_labels / structural clone classes
  + PageRank / Brandes / spectral / distance / HITS / Burt
  + multi-level Louvain / connected refinement
  + core / truss / cuts / robust blocks / attack
  + algebraic connectivity / Fiedler sign partition
  + bounded canonical simple-cycle witnesses
  + complete triad census / selected graphlets
  + IFDS / effect / taint / maybe-null summaries
  + SDG two-pass slicing
  + typed channel topology / linearity
  + communication / lock-order deadlock SCCs
  + typed AST may-happen-in-parallel pairs
  → exact structural relations + fixed points;<<#C3FAE8>>
fork again
  :PdgBuilder.build
  → backward_slice / forward_slice;<<#E5DBFF>>
fork again
  :Vf2Matcher subgraph match
  + bipartite GED upper bound
  → GoF detection / whole-graph similarity;<<#FFE3E3>>
fork again
  :per-function algorithm
  + complexity detection;<<#FFF3BF>>
fork again
  :CpgGnn.propagate
  → node / subgraph embeddings;<<#FCC2D7>>
end fork
:analysis results;
stop
legend right
  |= colour |= analysis (module) |
  |<#C3FAE8>| structural — blocks / data flow / IFDS / effects / taint / SDG / channels / deadlocks / MHP / graph analytics |
  |<#E5DBFF>| PDG — program slicing |
  |<#FFE3E3>| pattern — VF2 / GED / similarity / GoF |
  |<#FFF3BF>| algorithm + complexity |
  |<#FCC2D7>| GNN — embeddings |
endlegend
@enduml
