@startuml
!include _libcpg-theme.iuml
title ComplexityAnalyzer — preserved legacy time heuristic and total fallback
start
:function NodeId
+ AST loop / recursion patterns;<<#F1F3F5>>

partition "Loop shape  (analyze_loop_complexity)" #FFF3BF {
  if (maximum loop-nesting depth d?) then (no loop)
    :no loop estimate;<<#F1F3F5>>
  elseif (d = 1) then (single loop)
    :Linear  <latex>O(n)</latex>
confidence 0.8 counted / 0.6 unknown;<<#FFF3BF>>
  elseif (d = 2) then (nested twice)
    :Quadratic  <latex>O(n^2)</latex>
confidence 0.8 counted / 0.5 unknown;<<#FFF3BF>>
  elseif (d = 3) then (nested three times)
    :Cubic  <latex>O(n^3)</latex>
confidence 0.7;<<#FFF3BF>>
  else (d >= 4)
    :Polynomial(d)  <latex>O(n^d)</latex>
confidence 0.6;<<#FFF3BF>>
  endif
}

partition "Recursion shape  (analyze_recursion_complexity)" #FFE8CC {
  if (recursion kind / call shape?) then (no recursion)
    :no recursion estimate;<<#F1F3F5>>
  elseif (tail recursion) then (tail)
    :Linear  <latex>O(n)</latex>;<<#FFE8CC>>
  elseif (1 call, input halved) then (divide and conquer)
    :Logarithmic  <latex>O(\log n)</latex>;<<#FFE8CC>>
  elseif (2 calls, input halved) then (divide and conquer)
    :Linearithmic  <latex>O(n \log n)</latex>;<<#FFE8CC>>
    note right: <latex>T(n) = 2\,T(n/2) + O(n)</latex>
  elseif (at least 3 calls, input halved) then (divide and conquer)
    :Polynomial(calls)  <latex>O(n^{calls})</latex>;<<#FFE8CC>>
  elseif (1 call, no halving) then (linear recursion)
    :Linear  <latex>O(n)</latex>;<<#FFE8CC>>
  else (at least 2 calls, no halving)
    :Exponential  <latex>O(2^n)</latex>;<<#FFE8CC>>
  endif
}

:Keep the asymptotically worse class
via ComplexityClass::is_better_than;<<#F1F3F5>>
if (both estimates absent?) then (yes)
  :Constant  <latex>O(1)</latex>
confidence 0.9;<<#F1F3F5>>
else (no)
  :return selected loop or recursion estimate;<<#C3FAE8>>
endif
note right
  This exact behavior is the fallback for
  estimate_time_complexity_with_evidence.
  Neither public estimator emits Factorial.
end note
stop
legend right
  |= colour |= concept |
  |<#FFF3BF>| legacy loop heuristic |
  |<#FFE8CC>| legacy recursion heuristic |
  |<#F1F3F5>| fallback / combination |
  |<#C3FAE8>| advisory result |
endlegend
@enduml
